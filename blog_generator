import openai
from dotenv import dotenv_values #dotenv will take in the path to the .env file and return us the values
config = dotenv_values(".env")  #holds values in a dictionary
openai.api_key = config["API_KEY"]

def generate_blog(paragraph_topic): #defined a function called 'generate_blog' WITH ONE parameter 'paragraph_topic'
    response = openai.completions.create( #variable to store response generated by openai.completions.create
        model = 'gpt-3.5-turbo-instruct', #method to call on chat gpt 3.5
        prompt = 'write a paragraph about the following topic. ' + paragraph_topic, #the main instructions given to chatgpt
        max_tokens = 700, #length of response 100 tokens = 75 words
        temperature = 0.8 #randomness of response, 0-1 (0- same response, 1 - different response)
    )
    retrieve_blog = response.choices[0].text #used to access the value from response to text
    return retrieve_blog #return_blog holds the value in paragraph form from response
print(generate_blog('how do you make an LS7 engine make 790hp N/A.')) # tests function we created and gives it a prompt

keep_writing = True #identifeid keep_writing asa boolean for our while loop

while keep_writing:
    answer = input('write a paragraph? Y for yes, N for no: ') #varibale that will take user input // if 'Y' is selected it will ask for input regarding topic then execute generate_blog function
    if answer == 'y': #continues or stops the loop to continue writing paragraphs
        paragraph_topic = input('What should this paragraph be about?')
        print(generate_blog(paragraph_topic))
    else:
        keep_writing = False
